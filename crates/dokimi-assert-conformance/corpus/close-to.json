{
  "assertion": "close-to",
  "cases": [
    {
      "id": "close-to/inside-tolerance-passes",
      "args": [
        {
          "type": "float",
          "value": 1.02
        },
        {
          "type": "float",
          "value": 1.0
        },
        {
          "type": "float",
          "value": 0.05
        }
      ],
      "expect": "pass"
    },
    {
      "id": "close-to/bound-is-inclusive",
      "args": [
        {
          "type": "float",
          "value": 1.5
        },
        {
          "type": "float",
          "value": 1.0
        },
        {
          "type": "float",
          "value": 0.5
        }
      ],
      "expect": "pass"
    },
    {
      "id": "close-to/integer-answers",
      "args": [
        {
          "type": "int",
          "value": 10
        },
        {
          "type": "float",
          "value": 10.2
        },
        {
          "type": "float",
          "value": 0.5
        }
      ],
      "expect": "pass"
    },
    {
      "id": "close-to/outside-tolerance-fails",
      "args": [
        {
          "type": "float",
          "value": 2.0
        },
        {
          "type": "float",
          "value": 1.0
        },
        {
          "type": "float",
          "value": 0.05
        }
      ],
      "expect": "fail",
      "detail": {
        "got": {
          "type": "float",
          "value": 2.0
        },
        "want": {
          "type": "float",
          "value": 1.0
        },
        "tolerance": {
          "type": "float",
          "value": 0.05
        }
      }
    },
    {
      "id": "close-to/nan-value-fails",
      "args": [
        {
          "type": "float",
          "value": "NaN"
        },
        {
          "type": "float",
          "value": 1.0
        },
        {
          "type": "float",
          "value": "Inf"
        }
      ],
      "expect": "fail",
      "detail": {
        "got": {
          "type": "float",
          "value": "NaN"
        },
        "want": {
          "type": "float",
          "value": 1.0
        },
        "tolerance": {
          "type": "float",
          "value": "Inf"
        }
      }
    },
    {
      "id": "close-to/nan-want-fails",
      "args": [
        {
          "type": "float",
          "value": 1.0
        },
        {
          "type": "float",
          "value": "NaN"
        },
        {
          "type": "float",
          "value": 10.0
        }
      ],
      "expect": "fail",
      "detail": {
        "got": {
          "type": "float",
          "value": 1.0
        },
        "want": {
          "type": "float",
          "value": "NaN"
        },
        "tolerance": {
          "type": "float",
          "value": 10.0
        }
      }
    },
    {
      "id": "close-to/nan-tolerance-fails",
      "args": [
        {
          "type": "float",
          "value": 1.0
        },
        {
          "type": "float",
          "value": 1.0
        },
        {
          "type": "float",
          "value": "NaN"
        }
      ],
      "expect": "fail",
      "detail": {
        "got": {
          "type": "float",
          "value": 1.0
        },
        "want": {
          "type": "float",
          "value": 1.0
        },
        "tolerance": {
          "type": "float",
          "value": "NaN"
        }
      }
    },
    {
      "id": "close-to/equal-infinities-are-not-close",
      "args": [
        {
          "type": "float",
          "value": "Inf"
        },
        {
          "type": "float",
          "value": "Inf"
        },
        {
          "type": "float",
          "value": 1.0
        }
      ],
      "expect": "fail",
      "detail": {
        "got": {
          "type": "float",
          "value": "Inf"
        },
        "want": {
          "type": "float",
          "value": "Inf"
        },
        "tolerance": {
          "type": "float",
          "value": 1.0
        }
      }
    },
    {
      "id": "close-to/text-is-no-number",
      "args": [
        {
          "type": "string",
          "value": "1"
        },
        {
          "type": "float",
          "value": 1.0
        },
        {
          "type": "float",
          "value": 0.5
        }
      ],
      "expect": "fail",
      "detail": {
        "got": {
          "type": "string",
          "value": "1"
        },
        "want": {
          "type": "float",
          "value": 1.0
        },
        "tolerance": {
          "type": "float",
          "value": 0.5
        }
      }
    }
  ]
}
