{
  "kind": "links-to",
  "cases": [
    {
      "id": "links-to/the-stated-target-passes",
      "workspace": {
        "type": "tree",
        "entries": [
          {
            "path": "a.txt",
            "text": "a\n"
          },
          {
            "path": "current",
            "link": "a.txt"
          }
        ]
      },
      "args": [
        {
          "type": "string",
          "value": "current"
        },
        {
          "type": "string",
          "value": "a.txt"
        }
      ],
      "expect": "pass"
    },
    {
      "id": "links-to/a-target-outside-the-workspace-passes",
      "workspace": {
        "type": "tree",
        "entries": [
          {
            "path": "up",
            "link": "../outside.txt"
          }
        ]
      },
      "args": [
        {
          "type": "string",
          "value": "up"
        },
        {
          "type": "string",
          "value": "../outside.txt"
        }
      ],
      "expect": "pass"
    },
    {
