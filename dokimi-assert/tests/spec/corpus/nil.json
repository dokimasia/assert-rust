{
  "assertion": "nil",
  "cases": [
    {
      "id": "nil/null-passes",
      "args": [
        {
          "type": "null"
        }
      ],
      "expect": "pass"
    },
    {
      "id": "nil/zero-is-not-null",
      "args": [
        {
          "type": "int",
          "value": 0
        }
      ],
      "expect": "fail",
      "detail": {
        "got": {
          "type": "int",
          "value": 0
        }
      }
    },
    {
      "id": "nil/empty-string-is-not-null",
      "args": [
        {
          "type": "string",
          "value": ""
        }
      ],
      "expect": "fail",
      "detail": {
        "got": {
          "type": "string",
          "value": ""
        }
      }
    },
    {
      "id": "nil/empty-list-is-not-null",
      "args": [
        {
          "type": "list",
          "of": "int",
          "value": []
        }
      ],
      "expect": "fail",
      "detail": {
        "got": {
          "type": "list",
          "of": "int",
          "value": []
        }
      }
    }
  ]
}
