{
  "assertion": "empty",
  "cases": [
    {
      "id": "empty/empty-list-passes",
      "args": [
        {
          "type": "list",
          "of": "int",
          "value": []
        }
      ],
      "expect": "pass"
    },
    {
      "id": "empty/empty-string-passes",
      "args": [
        {
          "type": "string",
          "value": ""
        }
      ],
      "expect": "pass"
    },
    {
      "id": "empty/populated-list-fails",
      "args": [
        {
          "type": "list",
          "of": "int",
          "value": [
            1,
            2
          ]
        }
      ],
      "expect": "fail",
      "message_contains": [
        "2"
      ]
    }
  ]
}
