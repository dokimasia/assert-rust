{
  "assertion": "contains-in-order",
  "cases": [
    {
      "id": "contains-in-order/needles-in-order-pass",
      "args": [
        {
          "type": "string",
          "value": "a-b-c"
        },
        {
          "type": "list",
          "of": "string",
          "value": [
            "a",
            "b",
            "c"
          ]
        }
      ],
      "expect": "pass"
    },
    {
      "id": "contains-in-order/no-needles-pass",
      "args": [
        {
          "type": "string",
          "value": "anything"
        },
        {
          "type": "list",
          "of": "string",
          "value": []
        }
      ],
      "expect": "pass"
    },
    {
      "id": "contains-in-order/out-of-order-fails",
      "args": [
        {
          "type": "string",
          "value": "a-b-c"
        },
        {
          "type": "list",
          "of": "string",
          "value": [
            "c",
            "b"
          ]
        }
      ],
      "expect": "fail",
      "detail": {
        "needle": {
          "type": "string",
          "value": "b"
        },
        "index": {
          "type": "int",
          "value": 1
        }
      }
    },
    {
      "id": "contains-in-order/absent-needle-fails",
      "args": [
        {
          "type": "string",
          "value": "a-b-c"
        },
        {
          "type": "list",
          "of": "string",
          "value": [
            "a",
            "z"
          ]
        }
      ],
      "expect": "fail",
      "detail": {
        "needle": {
          "type": "string",
          "value": "z"
        },
        "index": {
          "type": "int",
          "value": 1
        }
      }
    },
    {
      "id": "contains-in-order/repeated-needle-must-match-twice",
      "args": [
        {
          "type": "string",
          "value": "a-b"
        },
        {
          "type": "list",
          "of": "string",
          "value": [
            "a",
            "a"
          ]
        }
      ],
      "expect": "fail",
      "detail": {
        "needle": {
          "type": "string",
          "value": "a"
        },
        "index": {
          "type": "int",
          "value": 1
        }
      }
    }
  ]
}
